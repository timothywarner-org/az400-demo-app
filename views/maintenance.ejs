<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | <%= appName %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand" href="/">
                <i class="bi bi-robot"></i> <%= appName %>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/robots">Robots</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="/maintenance">Maintenance</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/api/health/detailed" target="_blank">
                            <i class="bi bi-heart-pulse"></i> Health
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container my-4">

<div class="row">
    <div class="col-12">
        <h1 class="mb-4">Maintenance Dashboard</h1>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-4 mb-3">
        <div class="card text-dark card-maintenance">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="card-title mb-1">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>In Maintenance
                        </h5>
                        <h2 class="card-text mb-0" id="maintenanceCount">
                            <span class="sr-only">Loading maintenance count</span>-
                        </h2>
                        <small class="opacity-75">Currently being serviced</small>
                    </div>
                    <i class="bi bi-wrench dashboard-icon"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card text-white" style="background: linear-gradient(135deg, var(--info-color), #5a4fcf);">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="card-title mb-1">
                            <i class="bi bi-clock-history me-2"></i>Due for Maintenance
                        </h5>
                        <h2 class="card-text mb-0" id="dueCount">
                            <span class="sr-only">Loading due count</span>-
                        </h2>
                        <small class="opacity-75">Needs attention</small>
                    </div>
                    <i class="bi bi-clock-history dashboard-icon"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card text-white card-active">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="card-title mb-1">
                            <i class="bi bi-check-circle-fill me-2"></i>Recently Serviced
                        </h5>
                        <h2 class="card-text mb-0" id="recentCount">
                            <span class="sr-only">Loading recent count</span>-
                        </h2>
                        <small class="opacity-75">Within 7 days</small>
                    </div>
                    <i class="bi bi-check-circle dashboard-icon"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <h2 class="mb-3">Maintenance Queue</h2>
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Robot</th>
                                <th>Model</th>
                                <th>Status</th>
                                <th>Last Maintenance</th>
                                <th>Days Since</th>
                                <th>Priority</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="maintenanceTableBody">
                            <tr>
                                <td colspan="7" class="text-center">Loading maintenance data...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-12">
        <h2 class="mb-3">Maintenance Schedule</h2>
        <div class="card">
            <div class="card-body">
                <div id="scheduleCalendar" class="p-3 text-center text-muted">
                    <i class="bi bi-calendar3 display-1"></i>
                    <p class="mt-3">Maintenance schedule visualization coming soon!</p>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    loadMaintenanceData();
    setInterval(loadMaintenanceData, 60000); // Refresh every minute
});

function loadMaintenanceData() {
    fetch('/api/robots')
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                updateMaintenanceCounts(data.data);
                displayMaintenanceQueue(data.data);
            }
        })
        .catch(error => console.error('Error loading maintenance data:', error));
}

function updateMaintenanceCounts(robots) {
    const maintenanceRobots = robots.filter(r => r.status === 'Maintenance');
    const today = new Date();
    
    // Calculate maintenance statistics
    const dueForMaintenance = robots.filter(robot => {
        if (!robot.last_maintenance) return true;
        const lastMaintenance = new Date(robot.last_maintenance);
        const daysSince = Math.floor((today - lastMaintenance) / (1000 * 60 * 60 * 24));
        return daysSince > 30 && robot.status !== 'Maintenance';
    });
    
    const recentlyServiced = robots.filter(robot => {
        if (!robot.last_maintenance) return false;
        const lastMaintenance = new Date(robot.last_maintenance);
        const daysSince = Math.floor((today - lastMaintenance) / (1000 * 60 * 60 * 24));
        return daysSince <= 7;
    });
    
    document.getElementById('maintenanceCount').textContent = maintenanceRobots.length;
    document.getElementById('dueCount').textContent = dueForMaintenance.length;
    document.getElementById('recentCount').textContent = recentlyServiced.length;
}

function displayMaintenanceQueue(robots) {
    const tbody = document.getElementById('maintenanceTableBody');
    
    if (robots.length === 0) {
        tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted">No robots found</td></tr>';
        return;
    }
    
    // Sort robots by maintenance priority
    const sortedRobots = robots.sort((a, b) => {
        const aDays = calculateDaysSinceMaintenance(a.last_maintenance);
        const bDays = calculateDaysSinceMaintenance(b.last_maintenance);
        return bDays - aDays;
    });
    
    tbody.innerHTML = sortedRobots.map(robot => {
        const daysSince = calculateDaysSinceMaintenance(robot.last_maintenance);
        const priority = getMaintenancePriority(daysSince, robot.status);
        
        return `
            <tr>
                <td><strong>${escapeHtml(robot.name)}</strong></td>
                <td>${escapeHtml(robot.model)}</td>
                <td>
                    <span class="${getStatusBadgeClass(robot.status)}" aria-label="Status: ${robot.status}">
                        ${getStatusIcon(robot.status)}${robot.status}
                    </span>
                </td>
                <td>${robot.last_maintenance ? new Date(robot.last_maintenance).toLocaleDateString() : 'Never'}</td>
                <td>${daysSince === Infinity ? 'N/A' : daysSince + ' days'}</td>
                <td>
                    <span class="badge ${getPriorityBadgeClass(priority.color)}" aria-label="Priority: ${priority.label}">
                        ${getPriorityIcon(priority.color)}${priority.label}
                    </span>
                </td>
                <td>
                    <button class="btn btn-sm btn-warning" 
                            onclick="sendToMaintenance(${robot.id})"
                            aria-label="Schedule maintenance for ${robot.name}">
                        <i class="bi bi-wrench"></i> Schedule
                    </button>
                </td>
            </tr>
        `;
    }).join('');
}

function escapeHtml(text) {
    if (!text) return '';
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}

function getPriorityBadgeClass(color) {
    switch(color) {
        case 'danger': return 'badge status-badge status-offline';
        case 'warning': return 'badge status-badge status-maintenance';
        case 'info': return 'badge bg-info text-white';
        case 'primary': return 'badge bg-primary text-white';
        case 'success': return 'badge status-badge status-active';
        default: return 'badge bg-secondary';
    }
}

function getPriorityIcon(color) {
    switch(color) {
        case 'danger': return '<i class="bi bi-exclamation-triangle-fill me-1"></i>';
        case 'warning': return '<i class="bi bi-exclamation-circle-fill me-1"></i>';
        case 'info': return '<i class="bi bi-info-circle-fill me-1"></i>';
        case 'primary': return '<i class="bi bi-arrow-up-circle-fill me-1"></i>';
        case 'success': return '<i class="bi bi-check-circle-fill me-1"></i>';
        default: return '<i class="bi bi-dash-circle-fill me-1"></i>';
    }
}

function calculateDaysSinceMaintenance(lastMaintenance) {
    if (!lastMaintenance) return Infinity;
    const today = new Date();
    const last = new Date(lastMaintenance);
    return Math.floor((today - last) / (1000 * 60 * 60 * 24));
}

function getMaintenancePriority(daysSince, status) {
    if (status === 'Maintenance') {
        return { label: 'In Progress', color: 'info' };
    }
    if (daysSince === Infinity || daysSince > 60) {
        return { label: 'Critical', color: 'danger' };
    }
    if (daysSince > 30) {
        return { label: 'High', color: 'warning' };
    }
    if (daysSince > 14) {
        return { label: 'Medium', color: 'primary' };
    }
    return { label: 'Low', color: 'success' };
}

function sendToMaintenance(robotId) {
    fetch(`/api/robots/${robotId}`)
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                const robot = data.data;
                robot.status = 'Maintenance';
                
                return fetch(`/api/robots/${robotId}`, {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(robot)
                });
            }
        })
        .then(response => response.json())
        .then(result => {
            if (result.success) {
                showAlert('Robot sent to maintenance', 'success');
                loadMaintenanceData();
            }
        })
        .catch(error => console.error('Error:', error));
}

// Utility functions are defined in app.js

function showAlert(message, type) {
    const alertDiv = document.createElement('div');
    alertDiv.className = `alert alert-${type} alert-dismissible fade show position-fixed top-0 start-50 translate-middle-x mt-3`;
    alertDiv.style.zIndex = '1050';
    alertDiv.innerHTML = `
        ${message}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    `;
    document.body.appendChild(alertDiv);
    
    setTimeout(() => alertDiv.remove(), 5000);
}
</script>

    </main>

    <footer class="bg-light text-center py-3 mt-5">
        <div class="container">
            <p class="mb-0">
                <i class="bi bi-mortarboard"></i> AZ-400 Demo Application | 
                <i class="bi bi-person-badge"></i> By Tim Warner | 
                <i class="bi bi-book"></i> O'Reilly Live Learning
            </p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/app.js"></script>
</body>
</html>