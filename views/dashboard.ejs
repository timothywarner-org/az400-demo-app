<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | <%= appName %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand" href="/">
                <i class="bi bi-robot"></i> <%= appName %>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/robots">Robots</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/maintenance">Maintenance</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/api/health/detailed" target="_blank">
                            <i class="bi bi-heart-pulse"></i> Health
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container my-4">

<div class="row">
    <div class="col-12">
        <h1 class="mb-4">Robot Fleet Dashboard</h1>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-3 mb-3">
        <div class="card text-white card-active">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="card-title mb-1">
                            <i class="bi bi-check-circle-fill me-2"></i>Active Robots
                        </h5>
                        <h2 class="card-text mb-0" id="activeCount">
                            <span class="sr-only">Loading active robot count</span>-
                        </h2>
                        <small class="opacity-75">Currently operational</small>
                    </div>
                    <i class="bi bi-robot dashboard-icon"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card text-dark card-maintenance">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="card-title mb-1">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>In Maintenance
                        </h5>
                        <h2 class="card-text mb-0" id="maintenanceCount">
                            <span class="sr-only">Loading maintenance robot count</span>-
                        </h2>
                        <small class="opacity-75">Being serviced</small>
                    </div>
                    <i class="bi bi-wrench dashboard-icon"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card text-white card-offline">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="card-title mb-1">
                            <i class="bi bi-x-circle-fill me-2"></i>Offline
                        </h5>
                        <h2 class="card-text mb-0" id="offlineCount">
                            <span class="sr-only">Loading offline robot count</span>-
                        </h2>
                        <small class="opacity-75">Not operational</small>
                    </div>
                    <i class="bi bi-x-circle dashboard-icon"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card text-white card-total">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="card-title mb-1">
                            <i class="bi bi-collection-fill me-2"></i>Total Fleet
                        </h5>
                        <h2 class="card-text mb-0" id="totalCount">
                            <span class="sr-only">Loading total robot count</span>-
                        </h2>
                        <small class="opacity-75">All robots</small>
                    </div>
                    <i class="bi bi-collection dashboard-icon"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <h2 class="mb-3">Recent Activity</h2>
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Robot Name</th>
                        <th>Model</th>
                        <th>Status</th>
                        <th>Battery</th>
                        <th>Location</th>
                        <th>Task</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="robotTableBody">
                    <tr>
                        <td colspan="7" class="text-center">Loading robots...</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    loadDashboardData();
    setInterval(loadDashboardData, 30000); // Refresh every 30 seconds
});

function loadDashboardData() {
    fetch('/api/robots')
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                updateCounts(data.data);
                updateRobotTable(data.data);
            }
        })
        .catch(error => console.error('Error loading dashboard data:', error));
}

function updateCounts(robots) {
    const counts = {
        active: robots.filter(r => r.status === 'Active').length,
        maintenance: robots.filter(r => r.status === 'Maintenance').length,
        offline: robots.filter(r => r.status === 'Offline').length,
        total: robots.length
    };

    document.getElementById('activeCount').textContent = counts.active;
    document.getElementById('maintenanceCount').textContent = counts.maintenance;
    document.getElementById('offlineCount').textContent = counts.offline;
    document.getElementById('totalCount').textContent = counts.total;
}

function updateRobotTable(robots) {
    const tbody = document.getElementById('robotTableBody');
    
    if (robots.length === 0) {
        tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted">No robots found</td></tr>';
        return;
    }
    
    tbody.innerHTML = robots.map(robot => `
        <tr>
            <td><strong>${escapeHtml(robot.name)}</strong></td>
            <td>${escapeHtml(robot.model)}</td>
            <td>
                <span class="${getStatusBadgeClass(robot.status)}" aria-label="Status: ${robot.status}">
                    ${getStatusIcon(robot.status)}${robot.status}
                </span>
            </td>
            <td>
                <div class="progress position-relative" style="width: 120px; height: 24px;" 
                     aria-label="Battery level: ${robot.battery_level || 0}%">
                    <div class="progress-bar ${getBatteryProgressClass(robot.battery_level)}" 
                         style="width: ${robot.battery_level || 0}%"
                         role="progressbar" 
                         aria-valuenow="${robot.battery_level || 0}" 
                         aria-valuemin="0" 
                         aria-valuemax="100">
                    </div>
                    <span class="position-absolute w-100 text-center text-dark fw-bold" 
                          style="line-height: 24px; font-size: 0.75rem;">
                        ${getBatteryIcon(robot.battery_level)} ${robot.battery_level || 0}%
                    </span>
                </div>
            </td>
            <td>${escapeHtml(robot.location || 'Unknown')}</td>
            <td>${escapeHtml(robot.assigned_task || 'None')}</td>
            <td>
                <a href="/robot/${robot.id}" 
                   class="btn btn-sm btn-primary"
                   aria-label="View details for ${robot.name}">
                    <i class="bi bi-eye"></i> View
                </a>
            </td>
        </tr>
    `).join('');
}

function escapeHtml(text) {
    if (!text) return '';
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}

// Status and battery functions are now defined in app.js
</script>

    </main>

    <footer class="bg-light text-center py-3 mt-5">
        <div class="container">
            <p class="mb-0">
                <i class="bi bi-mortarboard"></i> AZ-400 Demo Application | 
                <i class="bi bi-person-badge"></i> By Tim Warner | 
                <i class="bi bi-book"></i> O'Reilly Live Learning
            </p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/app.js"></script>
</body>
</html>