# Application Configuration
NODE_ENV=development
PORT=3000

# Database Configuration (PostgreSQL)
# The app will automatically fall back to file storage if PostgreSQL is unavailable
DB_HOST=localhost
DB_PORT=5432
DB_NAME=robotfleet_dev
DB_USER=postgres
DB_PASSWORD=your_password_here

# Database names per environment (auto-selected based on NODE_ENV):
# development: robotfleet_dev
# staging: robotfleet_staging  
# production: robotfleet
# test: robotfleet_test

# Azure App Service Configuration
WEBSITE_NODE_DEFAULT_VERSION=18.x
WEBSITES_ENABLE_APP_SERVICE_STORAGE=true

# Application Settings
APP_NAME=Tim Warner's Teaching Robot Fleet (Development)
SESSION_SECRET=your_session_secret_here
JWT_SECRET=your_jwt_secret_here

# Logging
LOG_LEVEL=info

# Storage Options
# If PostgreSQL is unavailable, the app will use file-based storage
# File storage location: ./data/robots.json